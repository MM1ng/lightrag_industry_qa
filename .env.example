# Copy this file to .env and fill the secret locally. Never commit .env.
DASHSCOPE_API_KEY=
# Optional Bearer token for the local FastAPI service. Leave blank for unauthenticated local use.
SERVICE_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=kimi-k2.6
# Optional comma-separated fallback chain. Leave blank to use the built-in free-model chain.
LLM_FALLBACK_MODELS=qwen-plus-2025-07-28,qwen3.6-plus,qwen3.6-flash,qwen-plus
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024
LIGHTRAG_WORKING_DIR=./lightrag_storage
