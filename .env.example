# Industrial Energy Agent - Release Candidate 0.1.0-rc.1 environment template
# Copy to .env and fill values locally. NEVER commit .env or real secrets.

# --- Required: DashScope credential (provider) ---
# 必填。阿里云百炼 API Key。
DASHSCOPE_API_KEY=

# --- Optional: local FastAPI bearer token (leave blank for unauthenticated local use) ---
# 选填。启用后所有写接口需要 Authorization: Bearer <value>。
SERVICE_API_KEY=
# 必填（local_staging/production）。管理接口 Bearer Token；必须与 SERVICE_API_KEY 不同。
ADMIN_API_KEY=
# local_dev | local_staging | staging | production
IRA_DEPLOYMENT_ENVIRONMENT=local_dev

# --- Model / embedding (frozen strategy) ---
# 必填，必须与 frozen_strategy.json 一致。
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus-2025-07-28
MODEL_FALLBACK_ENABLED=false
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024
LIGHTRAG_WORKING_DIR=./lightrag_storage

# --- Vector backend (business default is nano; Qdrant KBs route by metadata) ---
VECTOR_BACKEND=nano
# 必填（Qdrant 基础设施地址）。
QDRANT_URL=http://127.0.0.1:16333
# 必填（Phase 4 冻结索引前缀）。
QDRANT_COLLECTION_PREFIX=ira_p3ar_4ac7a596
QDRANT_API_KEY=

# --- Database (optional; defaults to data/db/industrial_rag.db) ---
DATABASE_URL=

# --- ProductionQASettings overrides (all optional; locked by default) ---
# QA_LOCKED=true 时核心策略偏离会拒绝启动。
QA_LOCKED=true
QA_TOP_K=12
QA_CHUNK_TOP_K=20
QA_REQUEST_TIMEOUT_SECONDS=180
QA_MAX_RETRIES=2
QA_SAFETY_POLICY_ENABLED=true
QA_OBSERVABILITY_ENABLED=true

# --- Shadow audit / observability ---
CITATION_SHADOW_AUDIT_ENABLED=true
LOG_LEVEL=INFO

# --- Streamlit ---
# 选填。Streamlit 连接的后端 API 地址。
STREAMLIT_API_URL=http://127.0.0.1:8000

# --- Git (optional; overrides runtime commit detection) ---
GIT_COMMIT=

# --- MinerU (optional, default disabled; never part of the default chain) ---
MINERU_ENABLED=false
MINERU_API_BASE_URL=https://mineru.net
MINERU_API_KEY=
MINERU_API_VERSION=v4
MINERU_REQUEST_TIMEOUT_SECONDS=60
MINERU_TASK_TIMEOUT_SECONDS=600
MINERU_POLL_INTERVAL_SECONDS=3
MINERU_MAX_RETRIES=3
MINERU_FALLBACK_TO_PYMUPDF=true
MINERU_SAVE_RAW_RESPONSE=true
