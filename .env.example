# EnergyOps Copilot - copy to .env and fill only the values you need.
# Never commit .env or any real secret.

# BaiLian / OpenAI-compatible provider (Beijing region)
LLM_API_KEY=
# DASHSCOPE_API_KEY may be supplied by the process environment as a fallback.
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_MODEL=qwen3.7-plus
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSION=1024
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_MAX_CONCURRENCY=4
LLM_MAX_INPUT_TOKENS=32768
LLM_MAX_OUTPUT_TOKENS=4096

# Independent LightRAG REST service. Do not reuse the BaiLian key here.
LIGHTRAG_BASE_URL=http://127.0.0.1:9621
LIGHTRAG_API_KEY=
LIGHTRAG_TIMEOUT_SECONDS=60
LIGHTRAG_MAX_RETRIES=2

# Application runtime
DATABASE_URL=sqlite:///data/processed/energyops.sqlite3
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000
STREAMLIT_API_BASE_URL=http://127.0.0.1:8000
SERVICE_TOKEN=
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8501,http://localhost:8501

# Optional observability (disabled when unset)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
