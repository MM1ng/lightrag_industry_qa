"structural_valid": true, "invalid_chunk_count": 0, "invalid_page_count": 0, "invalid_document_count": 0, "duplicate_citation_count": 0, "emitted_citation_count": 3, "answer_without_citation": 0, "citation_traceability": 1, "cross_kb_reference": 0, "empty_citation_count": 0, "audit_status": "ok", "audit_mode": "shadow_non_blocking", "llm_called": false, "gold_used": false, "timestamp": "2026-08-02T17:00:06+0800"}, "cache_hit": true, "stage": "smoke", "note": null}
{"question_id": "SMK-03", "request_id": "bbdbf6041d41431583afc38eac575cf9", "trace_id": "08ae17a9470f491884ab53b2e30c39f1", "http_status": 200, "question": "入口管路应如何选择和布置？", "answer": "入口管路应选择至少比泵的法兰大一个尺码的管道，并通过偏心异径管接头与泵连接。偏心异径管接头应将平面朝上安装。弯管与入口法兰之间的距离应至少为十倍管径。此外，所有管路必须单独支撑，并与泵的入口法兰准确对正，不得强行对正。在与泵法兰直接相连的接头处，建议安装一小段软短管或波纹式短管。（依据：2196-ANSI-Manual-Chinese.pdf，第10页）", "citations": [{"citation_id": "cite_1", "document_name": "2196-ANSI-Manual-Chinese.pdf", "page": 10, "chunk_id": "cchunk-pymupdf-v1-护手册-c99ee01e2d93-000-c99ee01e2d93"}, {"citation_id": "cite_2", "document_name": "2196-ANSI-Manual-Chinese.pdf", "page": 10, "chunk_id": "cchunk-pymupdf-v1-护手册-a54d12ed5177-000-a54d12ed5177"}, {"citation_id": "cite_3", "document_name": "t1739cn.pdf", "page": 23, "chunk_id": "cchunk-pymupdf-v1--安装-649a484b68a5-000-649a484b68a5"}], "refusal": false, "refusal_reason": null, "parser_pipeline": "pymupdf_standard_adapter", "query_mode": "mix", "top_k": 12, "chunk_top_k": 20, "parent_expansion": "none", "rerank": false, "answer_model": "qwen-plus-2025-07-28", "requested_model": "qwen-plus-2025-07-28", "actual_model": ["qwen-plus-2025-07-28"], "fallback": false, "retrieved_chunk_ids": ["cchunk-pymupdf-v1-护手册-a54d12ed5177-000-a54d12ed5177", "cchunk-pymupdf-v1-和关闭-2020c244c35a-000-2020c244c35a", "cchunk-pymupdf-v1-护手册-60f631632134-000-60f631632134", "cchunk-pymupdf-v1-和关闭-2a44c976502c-000-2a44c976502c", "cchunk-pymupdf-v1--安装-a852e8dcc150-000-a852e8dcc150", "cchunk-pymupdf-v1-障诊断-eaae8ad09128-000-eaae8ad09128", "cchunk-pymupdf-v1--安装-c79b53d407c9-000-c79b53d407c9", "cchunk-pymupdf-v1--安装-2f479eae20bf-000-2f479eae20bf", "cchunk-pymupdf-v1--安装-649a484b68a5-000-649a484b68a5", "cchunk-pymupdf-v1--安装-4c0decacc13b-000-4c0decacc13b", "cchunk-pymupdf-v1--安装-23fbf21e5cf5-000-23fbf21e5cf5", "cchunk-pymupdf-v1-护手册-c99ee01e2d93-000-c99ee01e2d93", "cchunk-pymupdf-v1--安装-cc20e38cbf4c-000-cc20e38cbf4c", "cchunk-pymupdf-v1-护手册-8b9db897dbdf-000-8b9db897dbdf", "cchunk-pymupdf-v1-护手册-214f91586a2b-000-214f915